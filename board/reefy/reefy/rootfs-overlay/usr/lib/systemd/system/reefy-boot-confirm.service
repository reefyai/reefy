[Unit]
Description=reefy A/B boot slot confirmation
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/reefy-boot-confirm
# Hard ceiling for confirming a pending firmware slot.
# The storage supervisor owns repair interruption and diagnostic reboot.
TimeoutStartSec=3h

[Install]
WantedBy=multi-user.target
