[Unit]
Description=Reefy Log Publisher (journald → MQTT)
# Reopen the journal after its RAM-to-persistent mount transition.
After=reefy-control.service reefy-persistent-journal.service
Wants=reefy-control.service reefy-persistent-journal.service
PartOf=reefy-persistent-journal.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/reefy-log-publisher --units reefy-control,reefy-reconciler,reefy-storage-guard
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
