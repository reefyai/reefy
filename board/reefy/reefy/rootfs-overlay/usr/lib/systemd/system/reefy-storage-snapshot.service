[Unit]
Description=Create Reefy snapshots with reserved physical capacity
After=reefy-storage-guard.service reefy-storage-watchdog.service
# The worker durably holds writers before creating any snapshot. A crash after
# that point leaves the hold for the independent watchdog/recovery protocol.
# A generic OnFailure job could arrive after intentional cancellation/recovery
# and incorrectly refreeze healthy apps, so no second failure trigger is used.

[Service]
Type=oneshot
Environment=PYTHONPATH=/usr/lib/reefy
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m reefy.storage_snapshot_admission
TimeoutStartSec=120
TimeoutStopSec=10
MemoryMax=128M
CPUWeight=1000
OOMScoreAdjust=-900
