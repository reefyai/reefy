#!/bin/sh
# reefy-boot-watchdog: Safety net for A/B firmware updates.
# If reefy-boot-confirm doesn't stop us within TIMEOUT, reboot via sysrq.
# UEFI then falls back to old slot (BootNext was already consumed).
#
# Compare mounted/default partition GUIDs, not reusable BootCurrent numbers.
# Hardware watchdog is managed by systemd (RuntimeWatchdogSec).

TIMEOUT=360  # 6 minutes (must be longer than boot-confirm's 300s wait)

. /usr/lib/reefy/boot-slot-state.sh

# Normal boot — nothing to watch
# Storage may still be creating B and repairing entries after A is mounted.
if [ "$(systemctl show -p ActiveState --value reefy-storage.service)" = active ] && mounted_slot_is_default; then
    exit 0
fi

echo "[boot-watchdog] Watching unconfirmed mounted slot, will reboot in ${TIMEOUT}s if not confirmed"

# Storage work can legitimately outlast the boot budget. Never interrupt
# filesystem metadata writes with a rollback reboot. Match boot-confirm's
# accounting and resume the existing budget when the storage unit exits.
WAITED=0
while [ "$WAITED" -lt "$TIMEOUT" ]; do
    # Keep failed-storage diagnostics reachable without confirming a failed slot.
    if [ -e /run/reefy/storage-recovery-failed ]; then
        echo "[boot] Storage recovery failed; retaining diagnostics without rollback"
        exit 1
    fi
    STORAGE_STATE=$(systemctl show -p ActiveState --value reefy-storage.service)
    sleep 5 &
    wait $!
    if [ "$STORAGE_STATE" != activating ]; then
        WAITED=$((WAITED + 5))
    fi
done

# Close the state transition window at the end of the budget too.
while [ "$(systemctl show -p ActiveState --value reefy-storage.service)" = activating ]; do
    # Keep failed-storage diagnostics reachable without confirming a failed slot.
    if [ -e /run/reefy/storage-recovery-failed ]; then
        echo "[boot] Storage recovery failed; retaining diagnostics without rollback"
        exit 1
    fi
    sleep 5 &
    wait $!
done

# Keep failed-storage diagnostics reachable without confirming a failed slot.
if [ -e /run/reefy/storage-recovery-failed ]; then
    echo "[boot] Storage recovery failed; retaining diagnostics without rollback"
    exit 1
fi

# Recheck identity before rollback. An unreadable/missing default cannot be
# a safe rollback destination; preserve diagnostics instead of rebooting.
if mounted_slot_is_default; then
    exit 0
else
    SLOT_STATE=$?
fi
if [ "$SLOT_STATE" -ne 1 ]; then
    echo "[boot-watchdog] Cannot identify rollback destination; retaining diagnostics"
    exit 1
fi

# If we get here, boot-confirm never stopped us - reboot via sysrq
echo "[boot-watchdog] Boot confirmation timed out after ${TIMEOUT}s, rebooting"
echo b > /proc/sysrq-trigger
