#!/bin/sh
# Apply saved WiFi config early in boot, before network-online.target.
# Ensures WiFi connectivity is available even if ethernet is not connected.
# The reconciler will re-apply WiFi config later (idempotent).

STATE_FILE="/mnt/reefy-data/state/desired-state-v2.json"
[ -f "$STATE_FILE" ] || STATE_FILE="/mnt/reefy-data/state/desired-state.json"
# A tested local repair survives reboot until the backend acknowledges it.
if [ -f /mnt/reefy-data/state/wifi-portal-pending.json ] && PYTHONPATH=/usr/lib/reefy python3 -c 'from reefy.wifi_bootstrap import pending_credentials; raise SystemExit(0 if pending_credentials() else 1)'; then
    STATE_FILE="/mnt/reefy-data/state/wifi-portal-pending.json"
fi

if [ ! -f "$STATE_FILE" ]; then
    echo "[wifi-early] No saved desired state, skipping"
    exit 0
fi

# Extract WiFi SSID and password from desired-state.json
SSID=$(python3 -c "
import json, sys
try:
    s = json.load(open('$STATE_FILE'))
    w = (s.get('host', {}) if s.get('schema_version') == 2 else s).get('wifi', {})
    print(w.get('ssid', ''))
except Exception as exc:
    # Exception messages can contain private configuration values.
    print('[wifi-early] Saved WiFi state could not be read: ' + type(exc).__name__, file=sys.stderr)
")

if [ -z "$SSID" ]; then
    echo "[wifi-early] No WiFi config in desired state, skipping"
    exit 0
fi

PASSWORD=$(python3 -c "
import json, sys
try:
    s = json.load(open('$STATE_FILE'))
    w = (s.get('host', {}) if s.get('schema_version') == 2 else s).get('wifi', {})
    print(w.get('password', ''))
except Exception as exc:
    # Exception messages can contain private configuration values.
    print('[wifi-early] Saved WiFi state could not be read: ' + type(exc).__name__, file=sys.stderr)
")

echo "[wifi-early] Applying saved WiFi config: $SSID"
exec wifi-setup "$SSID" "$PASSWORD"
